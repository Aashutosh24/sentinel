# Copy to .env and adjust for your environment. Never commit the real .env.

APP_NAME="Sentinel AI"
ENVIRONMENT=development
DEBUG=true

# Async URL (asyncpg) used by the running app
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel_ai
# Sync URL (psycopg) used by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel_ai

# Generate a real value for anything beyond local dev, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

UPLOADS_DIR=/mnt/user-data/uploads

# LLM integration (optional — Copilot falls back to deterministic without these)
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT=15
