# Frontend environment template. Copy to .env.local for local overrides.
#
# Leave VITE_API_URL unset for local development: vite.config.ts proxies
# /api -> http://localhost:8000, so the default relative base "/api/v1" works
# with no CORS configuration at all.
#
# Set it only when the backend runs somewhere else (a deployed demo, a LAN
# machine, a tunnel):
# VITE_API_URL=http://localhost:8000/api/v1
